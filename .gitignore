# The updater signing key. If this leaks, anyone can publish a signed "update"
# that every Compass install will accept and run. It must never be committed.
# desktop/.gitignore also covers it; this is the belt to that pair of braces.
desktop/.tauri-updater.key
desktop/.tauri-updater.key.pub
*.key
*.pem
*.pfx

# Never commit the passphrase or any local secret file.
.env
.env.*

# Build output
desktop/src-tauri/target/
desktop/verify/target/
node_modules/

# Generated by tauri-build: ACL schemas and permission glue.
desktop/src-tauri/gen/

# Also generated by tauri-build, from the commands(&[...]) list in build.rs: one
# .toml per command, describing the permission that command needs. Regenerated on
# every build, so committing them would be a second copy of the ACL that can
# disagree with build.rs — and the four-place check in .build/verify-frontend.mjs
# already asserts that build.rs and the capability files agree, which is the fact
# these files are derived from.
desktop/src-tauri/permissions/autogenerated/

# The offline snapshot is generated from index.html by desktop/scripts/snapshot.mjs
# at build time. It is deliberately not committed: a second copy of the frontend
# in the repository is a copy that drifts.
desktop/local/

# OS noise
Thumbs.db
desktop.ini
.DS_Store
